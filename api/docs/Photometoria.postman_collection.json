						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('task_id', jsonData.task_id);",
									"    console.log('Task ID saved:', jsonData.task_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"context\": \"vacation in San Francisco, summer 2024\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/tasks",
							"host": ["{{base_url}}"],
							"path": ["api", "tasks"]
						},
						"description": "Creates a new task with the specified context.\n\nThe task_id is automatically saved to a collection variable for subsequent requests."
					},
					"response": [
						{
							"name": "Success",
