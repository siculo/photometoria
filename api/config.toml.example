# Photometoria API Server Configuration
#
# Copy this file to config.toml and adjust values as needed.
# In development mode, the server uses default values if config.toml is missing.
# In production mode, config.toml is required.

[server]
host = "0.0.0.0"
port = 8080

[storage]
path = "/var/photometoria/storage"
# Storage size with optional unit suffix.
#
# Decimal units (SI, base 1000):
#   KB = 1,000 bytes
#   MB = 1,000,000 bytes
#   GB = 1,000,000,000 bytes
#   TB = 1,000,000,000,000 bytes
#
# Binary units (IEC, base 1024):
#   KiB = 1,024 bytes
#   MiB = 1,048,576 bytes
#   GiB = 1,073,741,824 bytes
#   TiB = 1,099,511,627,776 bytes
#
# Examples:
#   max_size = "100GB"   # 100 billion bytes (decimal)
#   max_size = "100GiB"  # ~107.4 billion bytes (binary)
#   max_size = 1000000   # 1 million bytes (no suffix)
#
# Note: Filesystems typically use binary units (GiB), while
# hard drive manufacturers use decimal units (GB).
max_size = "10GiB"

[upload]
max_photos_per_request = 100
max_photo_size = "20MB"
# File maximum size with optional unit suffix.

# AI Provider Configuration
# -------------------------
# Configure AI providers for image analysis and metadata generation.

[ai]
# The default provider to use when none is specified in API requests.
default_provider = "ollama"
# The default language for AI-generated tags when not specified per-job.
# If omitted, tags are generated in English.
default_language = "English"

# Ollama Provider Configuration
# ----------------------------
# Ollama is a local AI model runner that supports vision models.
# See: https://ollama.ai

[ai.providers.ollama]
type = "ollama"
base_url = "http://localhost:11434"
# Timeout for a single AI analysis request, in seconds.
# Set this to accommodate the slowest model on the slowest GPU in your setup.
# Larger models (e.g. qwen2-vl:8b) and lower-VRAM cards need more time.
# If you see timeout errors, increase this value and use the retry endpoint
# to reprocess the failed photos.
timeout_seconds = 120
# GPU devices to use (empty = auto-detect)
devices = []

# Model Configurations
# --------------------
# Define the models available for this provider.
# The key (e.g., "qwen2-vl") is used as the model ID in API requests.

[ai.providers.ollama.models.qwen3_5]
ollama_model = "qwen3.5:latest"
prompt_template = """
Analyze this image and return descriptive tags as keywords.

Respond ONLY with valid JSON, no other text.
The JSON object must have a single key "tags" containing an array of objects.
Each object must have ONLY one key "tag" with a keyword string value.
Example: {"tags": [{"tag": "sunset"}, {"tag": "mountain"}, {"tag": "landscape"}, {"tag": "golden light"}, {"tag": "outdoor"}]}"""
description = "Qwen 3.5 model: recommended for production"
supports_vision = true
supported_languages = ["English", "Italian", "French", "German", "Spanish"]

[ai.providers.ollama.models.qwen3-vl]
ollama_model = "qwen3-vl:8b"
prompt_template = """
Analyze this image and return descriptive tags as keywords.

Respond ONLY with valid JSON, no other text.
The JSON object must have a single key "tags" containing an array of objects.
Each object must have ONLY one key "tag" with a keyword string value.
Example: {"tags": [{"tag": "sunset"}, {"tag": "mountain"}, {"tag": "landscape"}, {"tag": "golden light"}, {"tag": "outdoor"}]}"""
description = "Best quality vision model, slower processing"
supports_vision = true

[ai.providers.ollama.models.ministral-3]
ollama_model = "ministral-3:latest"
prompt_template = """
Analyze this image and return descriptive tags as keywords.

Respond ONLY with valid JSON, no other text.
The JSON object must have a single key "tags" containing an array of objects.
Each object must have ONLY one key "tag" with a keyword string value.
Example: {"tags": [{"tag": "sunset"}, {"tag": "mountain"}, {"tag": "landscape"}, {"tag": "golden light"}, {"tag": "outdoor"}]}"""
description = "Mistral vision model"
supports_vision = true

[ai.providers.ollama.models.llava]
ollama_model = "llava:latest"
prompt_template = """
Analyze this image and return descriptive tags as keywords.

Respond ONLY with valid JSON, no other text.
The JSON object must have a single key "tags" containing an array of objects.
Each object must have ONLY one key "tag" with a keyword string value.
Example: {"tags": [{"tag": "sunset"}, {"tag": "mountain"}, {"tag": "landscape"}, {"tag": "golden light"}, {"tag": "outdoor"}]}"""
description = "Fast vision model, good for development"
supports_vision = true

[ai.providers.ollama.models.gemma3n]
ollama_model = "gemma3n:e4b"
prompt_template = """
Analyze this image and return descriptive tags as keywords.

Respond ONLY with valid JSON, no other text.
The JSON object must have a single key "tags" containing an array of objects.
Each object must have ONLY one key "tag" with a keyword string value.
Example: {"tags": [{"tag": "sunset"}, {"tag": "mountain"}, {"tag": "landscape"}, {"tag": "golden light"}, {"tag": "outdoor"}]}"""
description = "Google Gemma 3n vision model"
supports_vision = true

# Worker Pool Configuration
# -------------------------
# Controls how the worker pool processes jobs and manages model switching.

[worker_pool]
# Minimum number of photos to process with the current model before allowing a swap.
# Higher values improve efficiency (fewer model reloads), lower values improve fairness.
# Must be >= 1. Default: 10
min_photos_before_swap = 10

# Maximum time to keep the same model loaded before forcing a swap.
# Ensures no job waits indefinitely when photos with a different model are queued.
# Supported suffixes: "ms" (milliseconds), "s" (seconds), "m" (minutes). Default: "120s"
max_time_before_swap = "120s"

# How long a worker sleeps when the photo buffer is empty before checking again.
# Lower values reduce processing latency at the cost of more CPU usage when idle.
# Supported suffixes: "ms" (milliseconds), "s" (seconds), "m" (minutes). Default: "500ms"
worker_idle_sleep = "500ms"

# How often the worker pool polls the job store for newly queued jobs.
# Lower values reduce the delay between job creation and processing start.
# Supported suffixes: "ms" (milliseconds), "s" (seconds), "m" (minutes). Default: "5s"
discovery_poll_interval = "5s"